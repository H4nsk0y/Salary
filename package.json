{
  "name": "alvisa-salary",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i ./styles/tailwind-input.css -o ./styles/tailwind.css --minify",
    "build:mobile": "npm run build:css && node scripts/build-mobile.mjs",
    "cap:sync": "npm run build:mobile && cap sync android",
    "cap:open:android": "cap open android",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build:css && npm test"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/core": "8.4.3"
  }
}
